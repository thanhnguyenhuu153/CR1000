<script type="text/javascript">
    // Function to track the tag selection event on tag collection.
    function tagCollectionTrackingEvent(tagName, categoryType) {
        var eventData = {
            event: 'select_tag',
            component: 'Category Component',
            page_type: 'Error',
        };

        if (categoryType === 'category') {
            eventData.article_category = tagName;
        } else if (categoryType === 'subCategory') {
            eventData.article_subcategory = tagName;
        } else {
            eventData.article_category = tagName;
            eventData.article_subcategory = tagName;
        }

        window.dataLayer.push(eventData);
    };
</script>
